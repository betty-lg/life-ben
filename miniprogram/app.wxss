page {
  background: #f4f5f2;
  color: #1c1c1a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.hint {
  margin: 24rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: #eaf3ee;
  color: #2a5c42;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.section-title {
  margin: 36rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1a;
  letter-spacing: 0.02em;
}

.section-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #2f6b4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 36rpx;
  text-align: center;
}

.section-title.ended-title .section-label {
  color: #6b6b66;
}

.section-title.ended-title .section-count {
  background: #c5c3bb;
  color: #fff;
}

.card {
  margin: 0 32rpx 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4de;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 28, 26, 0.03);
}

.card.pending {
  border-color: #c5ddcf;
  background: linear-gradient(180deg, #fbfefc 0%, #ffffff 48%);
}

.card.done-today {
  border-color: #e6e4de;
}

.card.ended {
  opacity: 0.92;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
  color: #1c1c1a;
}

.subline {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a84;
  line-height: 1.4;
}

.dot-sep {
  margin: 0 8rpx;
}

.status {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status.is-pending {
  background: #2f6b4f;
  color: #ffffff;
}

.status.is-done {
  background: #eef2ef;
  color: #5f7468;
}

.status.is-idle {
  background: #f3f1eb;
  color: #8a8a84;
}

.status.is-ended {
  background: #f1f0ec;
  color: #9a9a94;
}

.progress-row {
  margin-top: 22rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-num {
  font-size: 26rpx;
  color: #6b6b66;
}

.num-strong {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1c1a;
  letter-spacing: -0.02em;
}

.num-muted {
  font-size: 26rpx;
  color: #9a9a94;
}

.progress-hint {
  font-size: 22rpx;
  color: #9a9a94;
}

.progress {
  margin-top: 14rpx;
  height: 12rpx;
  background: #eceae4;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #2f6b4f;
  border-radius: 999rpx;
}

.actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.btn {
  margin: 0 !important;
  padding: 0 24rpx !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
  font-size: 24rpx !important;
  border-radius: 14rpx !important;
  border: 1rpx solid #ddd9d0 !important;
  background: #fff !important;
  color: #1c1c1a !important;
  font-weight: 500;
}

.btn::after {
  border: none !important;
}

.btn.primary {
  background: #2f6b4f !important;
  border-color: #2f6b4f !important;
  color: #fff !important;
  font-weight: 600;
}

.btn.primary[disabled] {
  background: #a7c4b4 !important;
  border-color: #a7c4b4 !important;
  color: #fff !important;
  opacity: 1 !important;
}

.btn.ghost {
  border-color: transparent !important;
  background: transparent !important;
  color: #9a9a94 !important;
  padding: 0 8rpx !important;
  font-weight: 400;
}

.meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b6b66;
  line-height: 1.5;
}

.meta.quiet {
  margin: 8rpx 32rpx 48rpx;
  color: #9a9a94;
  font-size: 22rpx;
}

.empty {
  padding: 64rpx 40rpx;
  text-align: center;
  color: #8a8a84;
  font-size: 26rpx;
  line-height: 1.7;
}
