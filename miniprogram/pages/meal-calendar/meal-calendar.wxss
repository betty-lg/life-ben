.page {
  padding: 24rpx 20rpx 80rpx;
  background: #f4f5f2;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 16rpx 0 24rpx;
  position: relative;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #6b6b66;
  background: #fff;
  border: 1rpx solid #e6e4de;
  border-radius: 50%;
}

.title {
  font-size: 32rpx;
  font-weight: 650;
  color: #1c1c1a;
  min-width: 240rpx;
  text-align: center;
}

.today-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx 22rpx;
  background: #fff;
  border: 1rpx solid #2f6b4f;
  color: #2f6b4f;
  font-size: 22rpx;
  font-weight: 500;
  border-radius: 999rpx;
  line-height: 1.2;
}

.weekdays {
  display: flex;
  background: #efeee9;
  border-radius: 12rpx 12rpx 0 0;
}

.wd {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: #6b6b66;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  background: #efeee9;
  border-radius: 0 0 16rpx 16rpx;
  padding-bottom: 8rpx;
}

.cell {
  width: 14.2857%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  margin-top: 8rpx;
  margin-left: 0.5%;
  margin-right: 0.5%;
  border-radius: 12rpx;
  position: relative;
  box-sizing: border-box;
}

.cell.empty {
  background: transparent;
}

.cell.today .day {
  color: #2f6b4f;
  font-weight: 700;
}

.cell.selected {
  background: #2f6b4f;
}

.cell.selected .day {
  color: #fff;
  font-weight: 700;
}

.cell.selected .dot {
  background: #fff;
}

.dot {
  margin-top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2f6b4f;
}

.day {
  font-size: 28rpx;
  color: #1c1c1a;
  line-height: 1;
}

.meal-block {
  margin-top: 8rpx;
  background: #fff;
  border: 1rpx solid #e6e4de;
  border-radius: 18rpx;
  padding: 24rpx 24rpx 16rpx;
}

.meal-block-head {
  margin-bottom: 12rpx;
}

.meal-block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1a;
  letter-spacing: 0.02em;
}

.section {
  margin-top: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.emoji {
  font-size: 28rpx;
  line-height: 1;
}

.section-label {
  font-size: 28rpx;
  font-weight: 650;
  color: #1c1c1a;
}

.section-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #2f6b4f;
  color: #fff;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 32rpx;
  text-align: center;
}

.meal-list {
  margin-top: 4rpx;
}

.meal-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eceae4;
}

.cover {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eceae4;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 26, 0.05);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #8a8a84;
  font-weight: 600;
  background: linear-gradient(135deg, #f0efe9 0%, #e7e5dd 100%);
}

.meal-main {
  flex: 1;
  min-width: 0;
}

.meal-title {
  font-size: 28rpx;
  font-weight: 650;
  color: #1c1c1a;
  line-height: 1.3;
}

.meal-preview {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8a84;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
