/* page-level */
.page {
  padding: 24rpx 28rpx 80rpx;
  background: #f4f5f2;
  min-height: 100vh;
}

.hint {
  margin: 0 0 16rpx;
  padding: 14rpx 18rpx;
  background: #eaf3ee;
  color: #2a5c42;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* section */
.section {
  margin-bottom: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4de;
  border-radius: 18rpx;
  padding: 24rpx 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 26, 0.03);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1a;
  flex: 1;
  letter-spacing: 0.02em;
}

.section-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #2f6b4f;
  color: #fff;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 32rpx;
  text-align: center;
}

.section-add {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  background: #2f6b4f;
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
}

.section-add:active {
  background: #265a42;
}

/* TODO list */
.todo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 16rpx 16rpx 12rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 12rpx;
}

.todo-item.done {
  opacity: 0.55;
}

.todo-item.overdue {
  border-color: #f0c0bb;
  background: #fff5f3;
}

.todo-check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.todo-check-box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c5c3bb;
  border-radius: 50%;
  background: #fff;
}

.todo-check-box.checked {
  background: #2f6b4f;
  border-color: #2f6b4f;
  color: #fff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.todo-item.overdue .todo-check-box {
  border-color: #e57367;
}

.todo-body {
  flex: 1;
  min-width: 0;
}

.todo-text {
  font-size: 28rpx;
  color: #1c1c1a;
  line-height: 1.4;
  word-break: break-all;
}

.todo-item.done .todo-text {
  text-decoration: line-through;
  color: #8a8a84;
}

.todo-meta {
  margin-top: 6rpx;
}

.todo-date {
  font-size: 22rpx;
  color: #9a9a94;
}

.todo-item.overdue .todo-date {
  color: #c25a00;
  font-weight: 600;
}

.todo-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #c2c0b8;
  font-size: 28rpx;
}

.todo-del:active {
  color: #a33b2c;
}

/* done fold */
.done-fold {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 4rpx 0;
}

.done-fold-line {
  flex: 1;
  height: 1rpx;
  background: #eceae4;
}

.done-fold-text {
  font-size: 22rpx;
  color: #8a8a84;
  flex-shrink: 0;
}

/* IDEAS */
.idea-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.idea-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 12rpx;
}

.idea-bulb {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1.2;
}

.idea-body {
  flex: 1;
  min-width: 0;
}

.idea-text {
  font-size: 28rpx;
  color: #1c1c1a;
  line-height: 1.5;
  word-break: break-all;
  white-space: pre-wrap;
}

.idea-time {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a9a94;
}

.idea-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: #c2c0b8;
  font-size: 28rpx;
}

.idea-del:active {
  color: #a33b2c;
}

.empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
  line-height: 1.6;
}

/* checkin sub-sections */
.sub-section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6b6b66;
}

.sub-section-title.ended-sub {
  margin-top: 20rpx;
}

.sub-section-count {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #c5c3bb;
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 28rpx;
  text-align: center;
}

/* checkin card */
.checkin-section .card {
  margin: 0 0 16rpx;
  padding: 24rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 14rpx;
  box-shadow: none;
}

.checkin-section .card.pending {
  border-color: #c5ddcf;
  background: linear-gradient(180deg, #fbfefc 0%, #faf9f5 48%);
}

.checkin-section .card.ended {
  opacity: 0.92;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 650;
  color: #1c1c1a;
  line-height: 1.3;
}

.subline {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a84;
}

.dot-sep {
  margin: 0 6rpx;
}

.status {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.status.is-pending { background: #2f6b4f; color: #fff; }
.status.is-done { background: #eef2ef; color: #5f7468; }
.status.is-idle { background: #f3f1eb; color: #8a8a84; }
.status.is-ended { background: #f1f0ec; color: #9a9a94; }

.card-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 6rpx;
  border-radius: 50%;
  color: #c2c0b8;
  font-size: 28rpx;
  line-height: 1;
}

.card-del:active { background: #f5f5f0; color: #a33b2c; }

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #6b6b66;
}

.progress-num .num-strong { font-size: 28rpx; font-weight: 700; color: #1c1c1a; }
.progress-num .num-muted { color: #9a9a94; }

.progress {
  margin-top: 8rpx;
  height: 8rpx;
  background: #eceae4;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #2f6b4f;
  border-radius: 999rpx;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.btn {
  margin: 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 0 18rpx;
  line-height: 56rpx;
  background: #ffffff;
  color: #2f6b4f;
  border: 1rpx solid #2f6b4f;
}

.btn[disabled] { color: #c5c3bb; border-color: #eceae4; }
.btn.primary { background: #2f6b4f; color: #fff; }
.btn.primary[disabled] { background: #eceae4; color: #c5c3bb; }
.btn.ghost { background: transparent; color: #6b6b66; border-color: #c5c3bb; }
.btn.ghost.danger { color: #a33b2c; border-color: #e7c0bb; }
.btn.ghost.danger:active { background: #fbe9e6; }

.meta.quiet { padding: 20rpx 0; text-align: center; color: #9a9a94; font-size: 22rpx; }

/* modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}

.modal-card {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1a;
  margin-bottom: 18rpx;
}

.modal-input {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 18rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.modal-sub {
  margin: 20rpx 0 10rpx;
  font-size: 22rpx;
  color: #8a8a84;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.quick-chip {
  padding: 12rpx 24rpx;
  background: #fff;
  border: 1rpx solid #c5c3bb;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b6b66;
}

.quick-chip.on {
  background: #2f6b4f;
  color: #fff;
  border-color: #2f6b4f;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1c1c1a;
}

.picker-row .picker-arrow { color: #c2c0b8; font-size: 30rpx; }

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 24rpx;
}

.modal-btn {
  margin: 0;
  padding: 0 24rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.modal-btn.cancel {
  background: #fff;
  color: #6b6b66;
  border: 1rpx solid #c5c3bb;
}

.modal-btn.ok {
  background: #2f6b4f;
  color: #fff;
  border: 1rpx solid #2f6b4f;
}
