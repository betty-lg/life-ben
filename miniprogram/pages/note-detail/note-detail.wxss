.page {
  padding: 28rpx 32rpx 80rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.h2 {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.3;
}

.icon-checkin {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  border: 1rpx solid #9bc4ad;
  background: #e4f0e9;
  color: #2f6b4f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.status-line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b6b66;
}

.cover {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #eceae4;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 26, 0.05);
}

.cover.learn-cover {
  border-radius: 50%;
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8a8a84;
  font-weight: 600;
  background: linear-gradient(135deg, #f0efe9 0%, #e7e5dd 100%);
}

.hero {
  margin-top: 24rpx;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #eceae4;
}

.method-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #d8d6cf;
}

.method-label {
  font-size: 24rpx;
  color: #6b6b66;
  font-weight: 650;
  margin-bottom: 16rpx;
}

.method-body {
  font-size: 28rpx;
  line-height: 1.75;
  color: #2a2a28;
}

/* 步骤展示（带编号 + 可选配图） */
.step-display {
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  background: #faf9f5;
  border: 1rpx solid #eceae4;
  border-radius: 12rpx;
}

.step-display:last-child {
  margin-bottom: 0;
}

.step-display-head {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: #2f6b4f;
  background: #e4f0e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.step-display-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #2a2a28;
  white-space: pre-wrap;
  word-break: break-word;
}

.step-display-img {
  display: block;
  margin-top: 14rpx;
  width: 100%;
  max-width: 520rpx;
  height: 360rpx;
  border-radius: 10rpx;
  background: #eceae4;
  white-space: pre-wrap;
}

.mat-section {
  margin-bottom: 16rpx;
}

.mat-section:last-child {
  margin-bottom: 0;
}

.mat-section-name-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a4a46;
}

.mat-section-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.mat-section-icon {
  font-size: 28rpx;
}

.mat-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #2a2a28;
  padding: 4rpx 0 4rpx 20rpx;
  position: relative;
}

.mat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9bc4ad;
}

.mat-amount {
  color: #6b6b66;
  font-size: 26rpx;
  white-space: nowrap;
}

.footer {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.reviews-empty {
  font-size: 26rpx;
  color: #9a9a94;
  line-height: 1.6;
}

.review {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.learn-body {
  margin-top: 24rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #2a2a28;
  white-space: pre-wrap;
}

.learn-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.learn-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #eaf3ee;
  color: #2a5c42;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.learn-tag-icon {
  font-size: 28rpx;
  line-height: 1;
}

.h2.muted {
  color: #8a8a84;
  font-weight: 600;
}

