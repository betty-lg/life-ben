.page {
  padding: 28rpx 32rpx 80rpx;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.h2 {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.3;
}

.icon-checkin {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  border: 1rpx solid #9bc4ad;
  background: #e4f0e9;
  color: #2f6b4f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.status-line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b6b66;
}

.hero {
  margin-top: 24rpx;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #eceae4;
}

.method-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #d8d6cf;
}

.method-label {
  font-size: 24rpx;
  color: #6b6b66;
  font-weight: 650;
  margin-bottom: 16rpx;
}

.method-body {
  font-size: 28rpx;
  line-height: 1.75;
  color: #2a2a28;
  white-space: pre-wrap;
}

.footer {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
