<view class="form">
  <view class="meal-hint" wx:if="{{mealLabel}}">
    <text class="meal-hint-emoji">📅</text>
    <text>将为这一餐记录：{{mealLabel}}</text>
  </view>

  <view class="field" wx:if="{{!isLearn}}">
    <view class="label">名称</view>
    <input placeholder="例如：五红汤 / 面膜" value="{{title}}" bindinput="onTitle" maxlength="40" />
  </view>

  <view class="field" wx:if="{{isLearn}}">
    <view class="label">标题（可选）</view>
    <input placeholder="默认「句子」" value="{{title}}" bindinput="onTitle" maxlength="40" />
  </view>

  <block wx:if="{{isFood}}">
    <view class="field">
      <view class="label">图片</view>
      <view class="img-box" wx:if="{{imagePath}}">
        <image class="preview" src="{{imagePath}}" mode="aspectFill" />
        <view class="img-actions">
          <button class="mini-btn" size="mini" bindtap="onChooseImage">更换</button>
          <button class="mini-btn ghost" size="mini" bindtap="onRemoveImage">移除</button>
        </view>
      </view>
      <button class="upload" wx:else bindtap="onChooseImage">上传图片</button>
    </view>
    <view class="field">
      <view class="label">简介</view>
      <textarea placeholder="一句话介绍这道菜…" value="{{intro}}" bindinput="onIntro" maxlength="200" auto-height />
    </view>
    <view class="field">
      <view class="label">标签<text class="label-hint">可多选，用于列表筛选</text></view>
      <view class="tag-pick">
        <view
          class="tag-chip {{item.on ? 'on' : ''}}"
          wx:for="{{tagOptions}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="onToggleTag"
        >{{item.name}}</view>
      </view>
    </view>
  </block>

  <view class="field" wx:if="{{isBeauty}}">
    <view class="label">摘要（列表展示）</view>
    <textarea placeholder="一行摘要，出现在美容列表里" value="{{intro}}" bindinput="onIntro" maxlength="120" auto-height />
  </view>

  <block wx:if="{{isFood || isBeauty}}">
    <view class="field">
      <view class="label">材料<text class="label-hint">可分组，如面团/馅料</text></view>
      <view class="mat-group" wx:for="{{matGroups}}" wx:for-index="gIdx" wx:key="gIdx">
        <view class="mat-group-head">
          <input
            placeholder="分组名（如面团、馅料，可不填）"
            value="{{item.name}}"
            data-g="{{gIdx}}"
            bindinput="onMatGroupName"
          />
          <view class="mat-group-del" wx:if="{{matGroups.length > 1}}" data-g="{{gIdx}}" bindtap="onDelMatGroup">删除</view>
        </view>
        <view class="mat-rows">
          <view class="mat-row" wx:for="{{item.rows}}" wx:for-item="row" wx:for-index="rIdx" wx:key="rIdx">
            <input class="mat-input name" placeholder="材料" value="{{row.name}}" data-g="{{gIdx}}" data-r="{{rIdx}}" bindinput="onMatName" />
            <input class="mat-input amount" placeholder="用量" value="{{row.amount}}" data-g="{{gIdx}}" data-r="{{rIdx}}" bindinput="onMatAmount" />
            <view class="mat-row-del" data-g="{{gIdx}}" data-r="{{rIdx}}" bindtap="onDelMatRow">×</view>
          </view>
          <view class="mat-add-row" data-g="{{gIdx}}" bindtap="onAddMatRow">+ 添加材料</view>
        </view>
      </view>
      <view class="mat-add-group" bindtap="onAddMatGroup">+ 添加一组</view>
    </view>
    <view class="field">
      <view class="label">步骤<text class="label-hint">每步可配一张图</text></view>
      <view class="step-list">
        <view class="step-item" wx:for="{{stepItems}}" wx:key="index" wx:for-index="idx">
          <view class="step-head">
            <view class="step-num">步骤 {{idx + 1}}</view>
            <view class="step-del" data-idx="{{idx}}" bindtap="onDelStep" wx:if="{{stepItems.length > 1}}">删除</view>
          </view>
          <textarea
            class="step-text"
            placeholder="这一步做什么…"
            value="{{item.text}}"
            data-idx="{{idx}}"
            bindinput="onStepText"
            maxlength="500"
            auto-height
          />
          <view class="step-img-row">
            <view class="step-img-box" wx:if="{{item.imagePath}}" data-idx="{{idx}}" bindtap="onPreviewStepImage">
              <image src="{{item.imagePath}}" mode="aspectFill" />
              <view class="step-img-del" data-idx="{{idx}}" catchtap="onDelStepImage">×</view>
            </view>
            <view class="step-img-upload" wx:else data-idx="{{idx}}" bindtap="onChooseStepImage">+ 上传配图</view>
          </view>
        </view>
      </view>
      <view class="step-add" bindtap="onAddStep">+ 添加步骤</view>
    </view>
    <view class="field">
      <view class="label">注意事项</view>
      <textarea placeholder="禁忌、频次、小贴士…" value="{{tips}}" bindinput="onTips" maxlength="2000" auto-height />
    </view>
  </block>

  <view class="field" wx:if="{{isLearn}}">
    <view class="label">内容</view>
    <textarea
      placeholder="把句子或段落记在这里。列表只会显示第一行。"
      value="{{body}}"
      bindinput="onBody"
      maxlength="5000"
      auto-height
    />
  </view>

  <view class="field" wx:if="{{isLearn}}">
    <view class="label">分类<text class="label-hint">用于列表展示，可单选</text></view>
    <view class="tag-pick">
      <view
        class="tag-chip learn {{item.on ? 'on' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onToggleTag"
      >
        <text wx:if="{{item.icon}}" class="tag-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <button class="save" bindtap="onSave">保存</button>
</view>
