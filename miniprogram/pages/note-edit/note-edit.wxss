.form {
  padding: 28rpx 32rpx 80rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: #6b6b66;
  margin-bottom: 12rpx;
  font-weight: 600;
}

input,
textarea,
.picker {
  width: 100%;
  background: #fff;
  border: 1rpx solid #d8d6cf;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

textarea {
  min-height: 160rpx;
}

.upload {
  background: #fff;
  color: #2f6b4f;
  border: 1rpx dashed #9bc4ad;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.img-box {
  background: #fff;
  border: 1rpx solid #d8d6cf;
  border-radius: 12rpx;
  overflow: hidden;
}

.preview {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #eceae4;
}

.img-actions {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
}

.mini-btn {
  margin: 0;
}

.mini-btn.ghost {
  background: transparent;
  color: #6b6b66;
}

.save {
  margin-top: 24rpx;
  background: #2f6b4f;
  color: #fff;
  border-radius: 12rpx;
  font-weight: 600;
}
