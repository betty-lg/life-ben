.cats {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid #d8d6cf;
  background: #f7f6f2;
  position: sticky;
  top: 0;
  z-index: 1;
}

.pill {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d8d6cf;
  font-size: 24rpx;
  color: #6b6b66;
  background: #fff;
}

.pill.on {
  background: #2f6b4f;
  border-color: #2f6b4f;
  color: #fff;
  font-weight: 600;
}

.list {
  padding: 8rpx 32rpx 120rpx;
}

.note-item {
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #d8d6cf;
}

.thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #eceae4;
  border: 1rpx solid #d8d6cf;
  flex-shrink: 0;
}

.thumb.img {
  display: block;
}

.note-main {
  flex: 1;
  min-width: 0;
}

.t {
  font-size: 30rpx;
  font-weight: 600;
}

.d {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b6b66;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  background: #2f6b4f;
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, 0.25);
}
