.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #f4f5f2;
  position: sticky;
  top: 0;
  z-index: 2;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: #fff;
  border: 1rpx solid #e6e4de;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.clear {
  font-size: 24rpx;
  color: #2f6b4f;
  padding: 8rpx;
}

.list {
  padding: 8rpx 32rpx 140rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eceae4;
}

.cover {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eceae4;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 26, 0.05);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #8a8a84;
  font-weight: 600;
  background: linear-gradient(135deg, #f0efe9 0%, #e7e5dd 100%);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 650;
  color: #1c1c1a;
}

.summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8a84;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  background: #2f6b4f;
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(47, 107, 79, 0.25);
}

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
  color: #8a8a84;
  font-size: 26rpx;
  line-height: 1.7;
}
