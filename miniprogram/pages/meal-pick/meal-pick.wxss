.page {
  padding: 24rpx 24rpx 80rpx;
  background: #f4f5f2;
  min-height: 100vh;
}

.header {
  margin-bottom: 16rpx;
}

.header-label {
  font-size: 26rpx;
  color: #6b6b66;
  font-weight: 500;
}

.search-bar {
  margin-bottom: 16rpx;
}

.search-wrap {
  height: 72rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e6e4de;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(28, 28, 26, 0.04);
  box-sizing: border-box;
}

.search-icon {
  font-size: 28rpx;
  color: #9a9a94;
  flex-shrink: 0;
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  padding: 0;
  font-size: 26rpx;
  background: transparent;
  border: none;
}

.clear {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  background: #eceae4;
  color: #6b6b66;
  font-size: 24rpx;
  border-radius: 50%;
}

.list {
  margin-top: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eceae4;
}

.row.taken {
  opacity: 0.55;
}

.cover {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eceae4;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 26, 0.05);
}

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #8a8a84;
  font-weight: 600;
  background: linear-gradient(135deg, #f0efe9 0%, #e7e5dd 100%);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  font-weight: 650;
  color: #1c1c1a;
  line-height: 1.3;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.badge {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 10rpx;
  background: #eceae4;
  color: #6b6b66;
  border-radius: 999rpx;
  line-height: 1.4;
}

.summary {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8a84;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.eaten {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #2a5c42;
  background: #eaf3ee;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  display: inline-block;
  line-height: 1.3;
}

.empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: #8a8a84;
  font-size: 26rpx;
  line-height: 1.7;
}
