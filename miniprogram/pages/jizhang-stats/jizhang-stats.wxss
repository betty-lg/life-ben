/* pages/stats/stats.wxss */
.container {
  padding: 20rpx 24rpx 48rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.total-card {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  color: white;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(46, 125, 50, 0.3);
}

.total-label {
  font-size: 26rpx;
  opacity: 0.85;
  display: block;
}

.total-amount {
  font-size: 56rpx;
  font-weight: bold;
  display: block;
  margin-top: 10rpx;
}

/* —— 近7天 —— */
.trend-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 12rpx;
}

.trend-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.trend-meta {
  font-size: 22rpx;
  color: #E53935;
}

.trend-avg {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 12rpx 20rpx;
}

.trend-chart {
  display: flex;
  align-items: flex-end;
  height: 280rpx;
  padding: 0 4rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.trend-value {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 8rpx;
  height: 28rpx;
  line-height: 28rpx;
}

.trend-value.zero {
  color: #ccc;
}

.trend-value.max {
  color: #E53935;
  font-weight: bold;
}

.trend-bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 120rpx;
}

.trend-bar {
  width: 40rpx;
  background: linear-gradient(180deg, #66BB6A, #2E7D32);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  min-height: 8rpx;
}

.trend-bar.zero {
  background: #e8e8e8;
  width: 28rpx;
}

.trend-bar.max {
  background: linear-gradient(180deg, #FF8A80, #E53935);
}

.trend-bar.today:not(.zero) {
  box-shadow: 0 0 0 4rpx rgba(46, 125, 50, 0.2);
}

.trend-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 10rpx;
}

.trend-label.today {
  color: #2E7D32;
  font-weight: bold;
}

.trend-week {
  font-size: 18rpx;
  color: #ccc;
  margin-top: 2rpx;
}

/* —— 月度对比 —— */
.compare-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title-inline {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.compare-hint {
  font-size: 22rpx;
  color: #bbb;
  margin: 8rpx 0 24rpx;
}

.compare-pair {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.compare-box {
  flex: 1;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.compare-box.current {
  background: #E8F5E9;
}

.compare-box-label {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.compare-box-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.compare-box.current .compare-box-amount {
  color: #2E7D32;
}

.compare-vs {
  padding: 0 12rpx;
  font-size: 22rpx;
  color: #ccc;
  font-weight: bold;
}

.compare-result {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  padding: 12rpx 4rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.compare-result.up {
  color: #E53935;
}

.compare-result.down {
  color: #2E7D32;
}

.compare-pct {
  font-weight: bold;
}

.monthly-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
}

.monthly-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.monthly-value {
  font-size: 18rpx;
  color: #999;
  height: 26rpx;
  margin-bottom: 6rpx;
}

.monthly-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.monthly-bar {
  width: 36rpx;
  background: #C8E6C9;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  min-height: 8rpx;
}

.monthly-bar.current {
  background: linear-gradient(180deg, #66BB6A, #2E7D32);
}

.monthly-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}

.monthly-label.current {
  color: #2E7D32;
  font-weight: bold;
}

/* —— 分类统计 —— */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin: 8rpx 4rpx 8rpx;
}

.section-hint {
  font-size: 22rpx;
  color: #bbb;
  margin: 0 4rpx 20rpx;
}

.stat-block {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.stat-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-amount {
  font-size: 34rpx;
  font-weight: bold;
  color: #E53935;
}

.stat-sub {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}

.note-list {
  margin-top: 12rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid #f5f5f5;
}

.note-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 16rpx 12rpx;
  border-bottom: 1rpx solid #fafafa;
}

.note-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.note-name {
  font-size: 28rpx;
  color: #666;
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-amount {
  font-size: 28rpx;
  color: #E53935;
  flex-shrink: 0;
}

.note-meta {
  font-size: 22rpx;
  color: #aaa;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.note-item.unclassified .note-name {
  color: #999;
  font-style: italic;
}

/* 2 级子分类 */
.sub-list {
  margin-top: 16rpx;
}

.sub-block {
  background: #faf9f5;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #eceae4;
}

.sub-block.ungrouped {
  background: #f5f5f0;
  border-style: dashed;
}

.sub-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.sub-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f6b4f;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-block.ungrouped .sub-name {
  color: #888;
  font-weight: 500;
}

.sub-meta {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}

.sub-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #E53935;
  flex-shrink: 0;
}

.sub-block .note-list {
  margin-top: 10rpx;
  border-top: 1rpx dashed #e6e4de;
  padding-top: 4rpx;
}

.sub-block .note-item {
  padding: 12rpx 0 12rpx 8rpx;
  font-size: 26rpx;
}

.sub-block .note-name {
  font-size: 26rpx;
}

.sub-block .note-amount {
  font-size: 26rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}

/* —— 本月预算 —— */
.budget-title {
  margin-top: 32rpx;
}

.budget-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.budget-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}

.budget-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.budget-amount {
  font-size: 26rpx;
  color: #6b6b66;
  font-weight: 500;
}

.budget-amount.over {
  color: #E53935;
}

.budget .progress-bar {
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.budget-item .progress-bar {
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.budget-item .progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #66BB6A, #2E7D32);
  border-radius: 8rpx;
  min-width: 0;
  transition: width 0.3s ease;
}

.budget-item .progress-bar.over .progress-fill {
  background: linear-gradient(90deg, #FF8A80, #E53935);
}

.budget-status {
  font-size: 22rpx;
  color: #2E7D32;
}

.budget-status.over {
  color: #E53935;
  font-weight: 600;
}
