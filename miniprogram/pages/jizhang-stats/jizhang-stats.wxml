<!--pages/stats/stats.wxml-->
<view class="container">
  <!-- 总支出 -->
  <view class="total-card">
    <text class="total-label">总支出</text>
    <text class="total-amount">¥{{total}}</text>
  </view>

  <!-- 近7天趋势 -->
  <view class="trend-card">
    <view class="trend-header">
      <text class="trend-title">近7天趋势</text>
      <text class="trend-meta" wx:if="{{trendMaxLabel}}">最高 {{trendMaxLabel}}</text>
    </view>
    <view class="trend-avg">日均 ¥{{trendAvg}}</view>

    <view class="trend-chart">
      <view wx:for="{{trendData}}" wx:key="key" class="trend-col">
        <text class="trend-value {{item.isZero ? 'zero' : ''}} {{item.isMax ? 'max' : ''}}">{{item.isZero ? '0' : item.valueText}}</text>
        <view class="trend-bar-track">
          <view
            class="trend-bar {{item.isZero ? 'zero' : ''}} {{item.isMax ? 'max' : ''}} {{item.isToday ? 'today' : ''}}"
            style="height:{{item.height}}%"
          ></view>
        </view>
        <text class="trend-label {{item.isToday ? 'today' : ''}}">{{item.label}}</text>
        <text class="trend-week">{{item.week}}</text>
      </view>
    </view>
  </view>

  <!-- 月度实时对比（对齐日） -->
  <view class="compare-card">
    <view class="section-title-inline">月度对比</view>
    <view class="compare-hint">{{monthCompare.dayHint}}</view>

    <view class="compare-pair">
      <view class="compare-box">
        <text class="compare-box-label">{{monthCompare.previousLabel}}</text>
        <text class="compare-box-amount">¥{{monthCompare.previousText}}</text>
      </view>
      <view class="compare-vs">VS</view>
      <view class="compare-box current">
        <text class="compare-box-label">{{monthCompare.currentLabel}}</text>
        <text class="compare-box-amount">¥{{monthCompare.currentText}}</text>
      </view>
    </view>

    <view class="compare-result {{monthCompare.direction}}">
      <text>{{monthCompare.diffText}}</text>
      <text wx:if="{{monthCompare.percentText}}" class="compare-pct">{{monthCompare.percentText}}</text>
    </view>

    <view class="monthly-chart" wx:if="{{monthlyData.length > 0}}">
      <view wx:for="{{monthlyData}}" wx:key="key" class="monthly-col">
        <text class="monthly-value">{{item.valueText}}</text>
        <view class="monthly-track">
          <view class="monthly-bar {{item.isCurrent ? 'current' : ''}}" style="height:{{item.height}}%"></view>
        </view>
        <text class="monthly-label {{item.isCurrent ? 'current' : ''}}">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 分类统计：1 级分类 → 2 级子分类 → 备注 三层 -->
  <view class="section-title">分类统计</view>
  <view class="section-hint">点 1 级分类看全部明细；下方按子分类汇总</view>

  <view wx:for="{{stats}}" wx:key="category" class="stat-block">
    <view class="stat-head" bindtap="showCategoryDetail" data-category="{{item.category}}">
      <text class="stat-name">{{item.category}}</text>
      <text class="stat-amount">¥{{item.totalText}}</text>
    </view>
    <view class="stat-sub">{{item.count}}笔 · 占比 {{item.percent}}%</view>

    <!-- 2 级子分类卡片 -->
    <view wx:if="{{item.subcategories.length > 0}}" class="sub-list">
      <view wx:for="{{item.subcategories}}" wx:for-item="sub" wx:key="name" class="sub-block {{sub.isSubcategory ? '' : 'ungrouped'}}">
        <view class="sub-head">
          <text class="sub-name">{{sub.name}}</text>
          <text class="sub-meta">{{sub.count}}笔 · 占比 {{sub.percent}}%</text>
          <text class="sub-amount">¥{{sub.totalText}}</text>
        </view>
        <!-- 备注行（2 级下所有笔记的备注聚合） -->
        <view wx:if="{{sub.notes.length > 0}}" class="note-list">
          <view wx:for="{{sub.notes}}" wx:for-item="note" wx:key="name" class="note-item {{note.isUnclassified ? 'unclassified' : ''}}">
            <text class="note-name">{{note.name}}</text>
            <text class="note-meta" wx:if="{{note.count > 1}}">×{{note.count}}</text>
            <text class="note-amount">¥{{note.totalText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{stats.length === 0}}" class="empty">
    <text>暂无数据</text>
  </view>

  <!-- 本月预算 -->
  <view class="section-title budget-title">本月预算</view>
  <view class="section-hint">总预算 ¥{{grandBudgetText}} · 已用 ¥{{grandSpentText}}</view>

  <view wx:if="{{budgets.length === 0}}" class="empty">
    <text>暂无预算数据</text>
  </view>

  <view wx:for="{{budgets}}" wx:key="category" class="budget-item">
    <view class="budget-head">
      <text class="budget-name">{{item.category}}</text>
      <text class="budget-amount {{item.over ? 'over' : ''}}">
        ¥{{item.spentText}} / ¥{{item.budgetText}}
      </text>
    </view>
    <view class="progress-bar {{item.over ? 'over' : ''}}">
      <view class="progress-fill" style="width:{{item.percent}}%"></view>
    </view>
    <view class="budget-status {{item.over ? 'over' : ''}}">
      <text wx:if="{{item.over}}">已超 ¥{{item.leftText}}</text>
      <text wx:else>剩余 ¥{{item.leftText}} · {{item.percentText}}%</text>
    </view>
  </view>
</view>
