/* pages/jizhang-index/jizhang-index.wxss */
.container {
  padding: 20rpx 24rpx 40rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.top-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(46, 125, 50, 0.25);
}

.action-btn.ghost {
  background: #fff;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}

.summary-card {
  display: flex;
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  border-radius: 20rpx;
  padding: 36rpx 16rpx;
  margin-bottom: 20rpx;
  color: white;
  box-shadow: 0 8rpx 30rpx rgba(46, 125, 50, 0.3);
}

.summary-item {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.summary-item:not(:last-child) {
  border-right: 2rpx solid rgba(255, 255, 255, 0.3);
}

.summary-item .label {
  font-size: 24rpx;
  opacity: 0.85;
  display: block;
}

.summary-item .amount {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.compare-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.compare-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.compare-percent {
  font-size: 26rpx;
  color: #999;
  font-weight: 600;
}

.compare-text.up,
.compare-percent.up {
  color: #E53935;
}

.compare-text.down,
.compare-percent.down {
  color: #2E7D32;
}

.avg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.avg-label {
  font-size: 26rpx;
  color: #999;
}

.avg-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.section-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-empty {
  font-size: 24rpx;
  color: #bbb;
  padding: 8rpx 0 4rpx;
}

.inline-empty {
  font-size: 24rpx;
  color: #bbb;
  padding: 16rpx 0 24rpx;
}

.top-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.top-item:last-child {
  margin-bottom: 0;
}

.top-head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.top-rank {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #2E7D32;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
  line-height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.top-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.top-amount {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 600;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #81C784);
  border-radius: 8rpx;
  min-width: 0;
}

.top-percent {
  font-size: 22rpx;
  color: #999;
}

.max-row {
  display: flex;
  align-items: center;
}

.max-category {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}

.max-meta {
  flex: 1;
  font-size: 24rpx;
  color: #999;
}

.max-amount {
  font-size: 32rpx;
  color: #E53935;
  font-weight: bold;
}

.max-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 4rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.clear-btn {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  padding: 10rpx 20rpx;
  background: #eee;
  border-radius: 30rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 28rpx;
}

.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 25rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.category-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.item-info .category {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.item-info .date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.item-info .note {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.item-right .amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #E53935;
}

.delete-btn {
  color: #ccc;
  font-size: 28rpx;
  padding: 10rpx;
  margin-left: 10rpx;
}

/* 备份导出卡片 */
.backup-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 40rpx 32rpx 24rpx;
  padding: 28rpx 28rpx;
  background: #fff;
  border: 1rpx solid #d8d6cf;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(28, 28, 26, 0.04);
}

.backup-icon {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.backup-body {
  flex: 1;
  min-width: 0;
}

.backup-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2a2a28;
  margin-bottom: 6rpx;
}

.backup-hint {
  font-size: 22rpx;
  color: #9a9a94;
  line-height: 1.5;
}

.backup-arrow {
  font-size: 36rpx;
  color: #c2c0b8;
  line-height: 1;
  flex-shrink: 0;
}
