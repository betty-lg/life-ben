/* page uses app.wxss */

/* 删除按钮：卡片右上角小 × */
.card-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  border-radius: 50%;
  color: #c2c0b8;
  font-size: 28rpx;
  line-height: 1;
}

.card-del:active {
  background: #f5f5f0;
  color: #a33b2c;
}

/* actions 里的"删除"按钮：警示色 */
.btn.ghost.danger {
  color: #a33b2c;
}

.btn.ghost.danger:active {
  background: #fbe9e6;
}