/* page uses app.wxss */

/* 删除按钮：卡片右上角小 × */
.card-del {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  border-radius: 50%;
  color: #c2c0b8;
  font-size: 28rpx;
  line-height: 1;
}

/* 累计摘要:从 X 开始,累计 N 天 */
.summary-line {
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  background: #f4f8f5;
  border: 1rpx solid #d4e5dc;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #2a5c42;
  line-height: 1.5;
  word-break: break-all;
}

.card-del:active {
  background: #f5f5f0;
  color: #a33b2c;
}

/* actions 里的"删除"按钮：警示色 */
.btn.ghost.danger {
  color: #a33b2c;
}

.btn.ghost.danger:active {
  background: #fbe9e6;
}