/* pages/add/add.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.form-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.form-item {
  margin-bottom: 40rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e0e0e0;
  padding-bottom: 10rpx;
}
.amount-input-wrap .currency {
  font-size: 40rpx;
  font-weight: bold;
  color: #2E7D32;
  margin-right: 10rpx;
}
.amount-input {
  flex: 1;
  font-size: 48rpx;
  font-weight: bold;
  padding: 10rpx 0;
  color: #333;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.category-tag {
  padding: 16rpx 32rpx;
  background: #f0f0f0;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.category-tag.active {
  background: #E8F5E9;
  color: #2E7D32;
  border-color: #4CAF50;
}

/* 2-level category tree (accordion card group) */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cat-group {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: padding 0.2s ease;
}

.cat-group.expanded {
  padding-bottom: 20rpx;
}

.cat-group.selected {
  background: #E8F5E9;
}

.cat-level-1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.cat-group.selected .cat-name {
  color: #2E7D32;
  font-weight: 600;
}

.cat-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cat-check {
  font-size: 30rpx;
  color: #2E7D32;
  font-weight: 700;
  line-height: 1;
}

.cat-arrow {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
  font-weight: 300;
  display: inline-block;
  transform: rotate(0deg);
  transition: transform 0.25s ease;
}

.cat-arrow.rotate {
  transform: rotate(90deg);
}

.cat-sub-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-left: 4rpx;
  margin-top: 16rpx;
}

.cat-tag {
  display: inline-block;
  padding: 10rpx 22rpx;
  background: #f0f0f0;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.cat-tag.cat-level-2 {
  font-size: 24rpx;
  padding: 10rpx 22rpx;
}

.cat-tag.active {
  background: #E8F5E9;
  color: #2E7D32;
  border-color: #4CAF50;
  font-weight: 600;
}

.picker-value {
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #333;
  border-bottom: 2rpx solid #e0e0e0;
}

.note-input {
  padding: 20rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid #e0e0e0;
  color: #333;
}

.save-btn {
  width: 100%;
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(46, 125, 50, 0.3);
}
.save-btn:active {
  opacity: 0.8;
}