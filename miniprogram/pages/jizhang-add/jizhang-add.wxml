<!--pages/add/add.wxml-->
<view class="container">
  <view class="form-card">
    <!-- 金额输入 -->
    <view class="form-item">
      <text class="label">金额</text>
      <view class="amount-input-wrap">
        <text class="currency">¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" bindinput="onAmountInput" value="{{amount}}"/>
      </view>
    </view>

    <!-- 分类选择（accordion 卡片组） -->
    <view class="form-item">
      <text class="label">分类</text>
      <view class="category-list">
        <view
          wx:for="{{categoryTree}}"
          wx:key="name"
          wx:for-item="cat"
          class="cat-group {{cat.expanded ? 'expanded' : ''}} {{selectedCategory === cat.name && !selectedSub ? 'selected' : ''}}"
        >
          <!-- 1 级 header -->
          <view
            class="cat-level-1"
            data-name="{{cat.name}}"
            bindtap="onToggleExpand"
          >
            <text class="cat-name">{{cat.name}}</text>
            <view class="cat-right">
              <text wx:if="{{selectedCategory === cat.name && !selectedSub}}" class="cat-check">✓</text>
              <text wx:if="{{cat.subcategories.length}}" class="cat-arrow {{cat.expanded ? 'rotate' : ''}}">›</text>
            </view>
          </view>
          <!-- 2 级子分类（accordion 展开） -->
          <view wx:if="{{cat.expanded && cat.subcategories.length}}" class="cat-sub-wrap">
            <view
              wx:for="{{cat.subcategories}}"
              wx:key="*this"
              wx:for-item="sub"
              class="cat-tag cat-level-2 {{selectedSub === sub ? 'active' : ''}}"
              data-category="{{cat.name}}"
              data-sub="{{sub}}"
              bindtap="onPickSub"
            >{{sub}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 日期 -->
    <view class="form-item">
      <text class="label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker-value">{{date}}</view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注</text>
      <input class="note-input" placeholder="可选，比如：午饭" bindinput="onNoteInput" value="{{note}}"/>
    </view>

    <!-- 保存按钮 -->
    <button class="save-btn" bindtap="saveExpense">保存记录</button>
  </view>
</view>