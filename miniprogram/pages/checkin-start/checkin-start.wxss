.form {
  padding: 28rpx 32rpx;
}

.card {
  padding: 24rpx;
  background: #fffefb;
  border: 1rpx solid #d8d6cf;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: #6b6b66;
  margin-bottom: 12rpx;
}

.seg {
  display: flex;
  gap: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border: 1rpx solid #d8d6cf;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
}

.seg-item.on {
  background: #e4f0e9;
  border-color: #9bc4ad;
  color: #2f6b4f;
  font-weight: 650;
}

input {
  background: #fff;
  border: 1rpx solid #d8d6cf;
  border-radius: 12rpx;
  padding: 20rpx;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.meta {
  font-size: 24rpx;
  color: #6b6b66;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.save {
  background: #2f6b4f;
  color: #fff;
  border-radius: 12rpx;
  font-weight: 600;
}
